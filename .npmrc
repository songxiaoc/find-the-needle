# Ensure native platform binaries (tailwind oxide, sharp, workerd) install for
# both the local macOS dev host and the Cloudflare (linux) build target.
supportedArchitectures.os[]=current
supportedArchitectures.os[]=linux
supportedArchitectures.cpu[]=current
supportedArchitectures.cpu[]=x64
supportedArchitectures.cpu[]=arm64

# pnpm 10 isolates the store more strictly than 8. eslint-config-next loads
# eslint-plugin-react-hooks as a Node module from the project root, so it
# must be hoisted.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=@next/eslint-plugin-next
