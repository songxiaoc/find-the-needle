# app
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
NEXT_PUBLIC_APP_NAME = "Your App Name"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "system"

# analytics (all optional — each script only loads when its ID is set)
# Google Analytics 4 measurement ID, e.g. "G-XXXXXXXXXX"
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID = ""
# Plausible site domain, e.g. "example.com"
NEXT_PUBLIC_PLAUSIBLE_ID = ""
# Microsoft Clarity project ID
NEXT_PUBLIC_CLARITY_ID = ""

# locale detection (off by default: a guide site wants stable, crawlable URLs)
NEXT_PUBLIC_LOCALE_DETECT_ENABLED = "false"

# NOTE: no database or auth variables. This template has no ORM and no runtime
# database — structured data lives in content/entities/*.json and is validated
# at build time. See docs/ENTITIES.md.
