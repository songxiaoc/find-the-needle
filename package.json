{
  "name": "find-the-needle",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/songxiaoc/find-the-needle.git"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:fast": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:site": "tsx scripts/validate-site.ts",
    "quality:gate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm validate:site && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "fumadocs-mdx",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --config wrangler.jsonc",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --config wrangler.jsonc",
    "cf:upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload --config wrangler.jsonc",
    "cf:typegen": "wrangler types --config wrangler.jsonc --env-interface CloudflareEnv src/shared/types/cloudflare.d.ts"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^15.5.7",
    "@next/third-parties": "^15.5.7",
    "@opennextjs/cloudflare": "^1.10.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@tabler/icons-react": "^3.34.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.13",
    "@vercel/analytics": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "15.7.12",
    "fumadocs-mdx": "11.10.0",
    "fumadocs-ui": "15.7.12",
    "github-markdown-css": "^5.8.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.543.0",
    "markdown-it": "^14.1.0",
    "next": "15.5.18",
    "next-intl": "^4.3.4",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "react": "19.2.1",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "19.2.1",
    "react-icons": "^5.5.0",
    "react-lazy-load-image-component": "^1.6.3",
    "react-use-measure": "^2.1.7",
    "recharts": "2.15.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rough-notation": "^0.5.1",
    "shiki": "^3.20.0",
    "sonner": "^2.0.7",
    "swiper": "^12.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "use-stick-to-bottom": "^1.1.1",
    "uuid": "^13.0.0",
    "vaul": "^1.1.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@tailwindcss/postcss": "^4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24",
    "@types/react": "19.2.2",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "19.2.1",
    "@types/react-lazy-load-image-component": "^1.6.4",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "15.5.7",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "sharp": "^0.35.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "wrangler": "^4.34.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.1"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  }
}
